    "start:member2": "node server/member2.js",
    "start:member3": "node server/member3.js",
    "start:member4": "node server/member4.js",
    "dev:member1": "node --watch server/member1.js",
    "dev:member2": "node --watch server/member2.js",
    "dev:member3": "node --watch server/member3.js",
    "dev:member4": "node --watch server/member4.js",
    "seed": "node scripts/seed.js",
    "db:init-replset": "node scripts/init-replset.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
