# ---------- Database ----------
# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers). Include the database name.
# If Node.js on Windows fails with "querySrv ECONNREFUSED", use the standard (non-SRV) format instead.
# Get the three host names with:  nslookup -type=SRV _mongodb._tcp.<cluster-host>
#   and the replicaSet name with:  nslookup -type=TXT <cluster-host>
# MONGODB_URI=mongodb://<db_user>:<db_password>@<host-00>:27017,<host-01>:27017,<host-02>:27017/medfind_bd?tls=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority
# Local development alternative: mongodb://127.0.0.1:27017/medfind_bd?replicaSet=rs0
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/medfind_bd?retryWrites=true&w=majority

# ---------- Auth ----------
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------- Ports (last four digits of each member's student ID) ----------
PORT_ALL=5000
PORT_MEMBER1=9421
PORT_MEMBER2=9050
PORT_MEMBER3=1783
PORT_MEMBER4=1274

# Base URL used for links to locally stored uploads (empty = use the request host)
PUBLIC_BASE_URL=

# ---------- File storage (Cloudinary) ----------
# Leave empty to store uploads on local disk under backend/uploads (development fallback).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (SendGrid) ----------
# Leave empty to log emails to the console instead of sending them.
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@medfind.example

# ---------- Business rules ----------
TIMEZONE_OFFSET=+06:00
RESERVATION_PICKUP_GRACE_MINUTES=120
RESERVATION_MIN_LEAD_MINUTES=30
RESERVATION_MAX_DAYS_AHEAD=7
SUSPENSION_MIN_VALID_COMPLAINTS=3
SUSPENSION_WINDOW_DAYS=30

# ---------- Scheduled jobs ----------
# Set to false to disable node-cron jobs in a process
CRON_ENABLED=true
