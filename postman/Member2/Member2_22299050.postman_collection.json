              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has success flag', () => pm.expect(pm.response.json()).to.have.property('success', true));",
                  "{ const item = pm.response.json().data.reservations.find((x) => x.medicine.includes('Seclo'));",
                  "  if (item) pm.collectionVariables.set('rejectReservationId', item.id); }",
                  "{ const item = pm.response.json().data.reservations.find((x) => x.medicine.includes('Napa 500 mg x 10') && x.patient.name === 'Ayesha Siddika');",
                  "  if (item) pm.collectionVariables.set('cancelReservationId', item.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
