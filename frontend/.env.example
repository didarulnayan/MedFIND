# Copy this file to .env (frontend/.env). No secrets belong here: everything in a Vite .env
# that starts with VITE_ is visible in the browser.

# Base path the browser uses for API calls. Keep "/api" in development (Vite proxies it).
# For a deployed frontend, set the full backend URL, e.g. https://medfind-api.onrender.com/api
VITE_API_URL=/api

# Development only: which backend server Vite forwards /api to.
# http://127.0.0.1:5000 = all 8 features (npm start in backend). A member server (e.g. :1274) only has that member's APIs.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
